# Copy this file to .env and fill in real values. NEVER commit your .env to source control.

# Your Supabase project URL (example: https://xyzcompany.supabase.co)
SUPABASE_URL=REPLACE_WITH_SUPABASE_URL

# Server-only service role key (KEEP SECRET; server must use this)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Public ANON key used by the browser client (safe-ish, but keep track)
SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY

# Admin password used by the admin-delete endpoint (choose a strong value)
ADMIN_DELETE_PASSWORD=quocadmin


